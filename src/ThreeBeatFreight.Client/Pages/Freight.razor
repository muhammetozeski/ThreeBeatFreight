@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<Freight> Log
<PageTitle>Three Beat Freight — plan, collide, deliver</PageTitle>
<div class="app-shell">
<header><a class="brand" href="/">THREE BEAT <b>FREIGHT</b></a><span class="tag">Three commands. Four energy. Shared trouble.</span></header>
<nav aria-label="Game sections">@foreach(var tab in new[]{"Play","Friends","Arena lab","Rules"}){<button class="@(Tab==tab?"active":"")" @onclick='()=>Tab=tab'>@tab</button>}<a href="/privacy.html">Privacy</a></nav>
@if(Busy){<p class="notice" role="status">Working…</p>}
@if(!string.IsNullOrEmpty(Error)){<p class="error" role="alert">@Error</p>}
@if(!string.IsNullOrEmpty(Message)){<p class="notice" role="status">@Message</p>}
@if(V is null){<main><h1>Opening the freight yard</h1><p>The game runs in your browser. Private rooms use the live service.</p></main>}
else{
@if(!string.IsNullOrEmpty(V.Notice)){<p class="notice">@V.Notice</p>}
@if(Tab=="Play"){
<main>
@if(V.State is null){
<div class="entry"><section><p class="eyebrow">SOLO · SAME RULES AS LIVE ROOMS</p><h1>Get the crate.<br />Keep the crate.<br />Get home.</h1><p>Plan three commands together, then watch every beat unfold. Shoves spill cargo. Belts change routes. A good return trip matters more than a fast start.</p><button class="primary" disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("startSolo",V.Contracts[0].Id))'>Start first delivery</button><button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("startPractice",ArenaId))'>Spar with a local dispatch bot</button><p class="small">No account or key needed for solo. Records stay in this browser.</p></section><section class="instruction-grid"><b>1. PROGRAM</b><span>Three steps, shoves, braces or waits. Four energy total.</span><b>2. REVEAL</b><span>All couriers act. Collisions are resolved together.</span><b>3. RETURN</b><span>Bring cargo to your colored home dock to score.</span></section></div>
}
else{<div class="match-head"><div><p class="eyebrow">@(V.Room is null?(V.Theatre?"IMPORTED REPLAY · READ ONLY":V.Practice?"LOCAL AUTOMATED RIVAL · NOT AN ONLINE PLAYER":"SOLO CONTRACT"):"PRIVATE ROOM · "+V.Room.Id)</p><h1>@V.State.Board.Title</h1><p>Round @V.State.Round / @V.State.RoundLimit · @V.State.Phase</p></div><button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("leave"))'>Leave board</button></div>
<div class="game-layout"><section class="arena-panel">
<div class="board" role="img" aria-label="Cargo arena. Coordinates and contents are available on each tile." style="grid-template-columns:repeat(@V.State.Board.Tiles[0].Length,1fr)">
@for(var y=0;y<V.State.Board.Tiles.Count;y++){@for(var x=0;x<V.State.Board.Tiles[y].Length;x++){var cx=x;var cy=y;var terrain=V.State.Board.Tiles[y][x];var courier=ShownPlayers.FirstOrDefault(p=>p.X==cx&&p.Y==cy);var cargo=ShownCrates.FirstOrDefault(p=>p.X==cx&&p.Y==cy);var dock=V.State.Board.Docks.FindIndex(p=>p.X==cx&&p.Y==cy);<div class="tile @TileClass(terrain)" title="@CellLabel(cx,cy,terrain,courier,cargo,dock)"><span class="terrain">@TerrainLabel(terrain)</span>@if(dock>=0){<span class="dock" style="border-color:@Color(dock)">D@(dock+1)</span>}@if(cargo is not null){<span class="crate" aria-label="Cargo">◆</span>}@if(courier is not null){<span class="courier" style="background:@Color(courier.Seat);color:#10121a">@(courier.Seat+1)@(courier.Cargo is null?"":"◆")</span>}</div>}}
</div>
<div class="legend"><span>◆ cargo</span><span>D home dock</span><span>→ belt</span><span>× recovery pit</span><span>0/1/2 timed shock</span></div>
<div class="scores">@foreach(var p in V.State.Players){<div style="border-left:5px solid @Color(p.Seat)"><b>@p.Alias @(p.Id==OwnId?"(you)":"")</b><span>@p.Score delivered · @p.Falls recoveries</span><span>@(p.Cargo is null?"Empty hands":"Carrying "+p.Cargo)</span></div>}</div>
@if(V.State.Result is not null){<section class="result"><h2>@ResultText</h2><p>@(V.Room is null?"Try a different route, replay the contract, or invite a real opponent.":"The result belongs to these actual room participants. No global ranking is implied.")</p><button class="primary" disabled="@Busy" @onclick='ReplayMatch'>@(V.Room is null?"Play again":"Create rematch lobby")</button><button disabled="@Busy" @onclick='()=>Download("replay")'>Export replay</button></section>}
@if(ShownReplay is not null){<section class="replay">@if(V.AvailableReplays.Count>1){<div class="button-row">@foreach(var past in V.AvailableReplays){<button @onclick="()=>SelectReplay(past)">Round @past.Round</button>}</div>}<h2>@(Prediction?"Prediction · others wait":"Round "+ShownReplay.Round+" replay")</h2><div class="button-row"><button @onclick='()=>FrameIndex=-1'>Current board</button>@for(var i=0;i<ShownReplay.Frames.Count;i++){var fi=i;<button class="@(FrameIndex==i?"active":"")" @onclick='()=>FrameIndex=fi'>Beat @(i+1)</button>}</div>@if(Prediction){<p class="small">This is a conditional preview. Other couriers' hidden plans are not known.</p>}
@if(FrameIndex>=0){<ol class="event-list">@foreach(var evt in ShownReplay.Frames[FrameIndex].Events){<li>@EventText(evt)</li>}</ol>}
@if(!Prediction){<details><summary>Revealed three-command plans</summary>@foreach(var item in ShownReplay.Plans){<p><b>@Alias(item.Key)</b>: @string.Join(" → ",item.Value.Select(c=>c.Label))</p>}@if(ShownReplay.AutomaticWaits.Count>0){<p>Deadline waits for: @string.Join(", ",ShownReplay.AutomaticWaits.Select(Alias)). These are missing player submissions, not computer players.</p>}</details>}
</section>}
</section><aside class="program-panel"><h2>Your program</h2><p>Energy <b class="@(Energy>4?"bad":"")">@Energy / 4</b></p>
@if(V.Room is not null){<p>@V.Room.CommittedIds.Count / @V.Room.Members.Count committed. @DeadlineText</p>@if(Committed){<p class="notice">Your plan is locked. It will be revealed when all plans arrive or the deadline passes.</p>}}
@for(var i=0;i<Plan.Count;i++){var slot=i;<div class="command"><label>Beat @(i+1)<select value="@Plan[i].Kind" disabled="@(Busy||Committed||V.Theatre||V.State.Phase!="planning")" @onchange='e=>SetKind(slot,e.Value?.ToString()??"wait")'><option value="move">Step · 1</option><option value="shove">Shove · 2</option><option value="brace">Brace · 1</option><option value="wait">Wait · 0</option></select></label>@if(Plan[i].Kind is "move" or "shove"){<label>Direction<select @bind="Plan[slot].Direction" disabled="@(Busy||Committed||V.Theatre)"><option value="up">↑ Up</option><option value="right">→ Right</option><option value="down">↓ Down</option><option value="left">← Left</option></select></label>}</div>}
<button class="primary wide" disabled="@(Busy||Committed||V.Theatre||Energy>4||V.State.Phase!="planning")" @onclick='Commit'>@(V.Room is null?"Resolve three beats":"Commit secret plan")</button><button class="wide" disabled="@(Busy||V.Theatre||Energy>4||V.State.Phase!="planning")" @onclick='Predict'>Preview assuming others wait</button>
@if(V.Room is null){var contract=V.Contracts.FirstOrDefault(c=>c.Id==V.ContractId);@if(contract is not null){<div class="brief"><h3>@contract.Title</h3><p>@contract.Brief</p><p>Target @contract.Deliveries · at most @contract.MaximumFalls recoveries · @contract.Rounds rounds</p><details><summary>Dispatch hint</summary><p>@contract.Hint</p></details></div>}}
else{<button class="wide" disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("refresh"),false)'>Refresh / reconnect</button>}
</aside></div>}
<section class="contracts"><h2>UTC dispatch of the day · @V.Daily.Day</h2><p>Everyone receives the same featured contract for this UTC date. Results remain local.</p><button class="primary" disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("startSolo",V.Daily.ContractId))'>Play the daily dispatch</button><h2>Dispatch board</h2><p>Original solo contracts. Your best local attempts are marked below; they are not online rankings.</p><div class="contract-list">@foreach(var c in V.Contracts){var best=V.Records.Where(r=>r.ContractId==c.Id).OrderBy(r=>r.Rounds).FirstOrDefault();<button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("startSolo",c.Id))'><b>@c.Title</b><span>@c.Brief</span><small>@c.Deliveries cargo · @c.Rounds rounds@(best is null?"":" · best: "+best.Rounds+" rounds")</small></button>}</div></section>
</main>}
@if(Tab=="Friends"){
<main class="friends"><h1>Bring a real rival</h1><p>2–4 actual couriers. Six rounds, simultaneous secret programs, no elimination. Each round has a 90-second server deadline; unsubmitted plans become disclosed waits.</p>
@if(V.User is null){<section><h2>Your courier</h2><label>Public room alias<input maxlength="24" @bind="NewAlias" /></label><button class="primary" disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("register",NewAlias))'>Create free courier</button><details><summary>Recover an existing courier</summary><label>Recovery key<input type="password" autocomplete="off" maxlength="64" @bind="Recovery" /></label><button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("recover",Recovery))'>Recover</button></details><p class="small">A secure browser cookie keeps your identity. No email is requested. Save the recovery key if you need another device.</p></section>}
else{<p>Signed in as <b>@V.User.Alias</b>. <button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("logout"))'>Sign out</button></p>@if(V.RecoveryKey is not null){<section class="recovery"><h2>Save this recovery key now</h2><code>@V.RecoveryKey</code><p>Shown for this creation only. Anyone with it can use your courier. It is never included in game exports.</p></section>}
<div class="friend-columns"><section><h2>Create a lobby</h2><label>Arena<select @bind="ArenaId">@foreach(var a in V.Arenas){<option value="@a.Id">@a.Title</option>}</select></label><button class="primary" disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("createRoom",ArenaId))'>Create private lobby</button></section><section><h2>Join a lobby</h2><label>Room code or invitation URL<input @bind="JoinCode" maxlength="300" /></label><button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("joinRoom",JoinCode))'>Join as yourself</button></section></div>
@if(V.Room is not null){<section><h2>Room @V.Room.Id · @V.Room.Phase</h2><label>Invitation<input readonly value="@InviteUrl" /></label><button @onclick='CopyInvite'>Copy invitation</button><ul>@foreach(var p in V.Room.Members){<li>@p.Alias @(p.Id==V.Room.HostId?"· host":"")</li>}</ul>@if(V.Room.Phase=="lobby"&&V.Room.HostId==V.User.Id){<button class="primary" disabled="@(Busy||V.Room.Members.Count<2)" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("startRoom"))'>Start with @V.Room.Members.Count real players</button>}@if(V.Room.Phase!="lobby"){<button class="primary" @onclick='()=>Tab="Play"'>Open arena</button>}<button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("refresh"),false)'>Refresh room</button></section>}
<section><h2>Your recent rooms</h2>@foreach(var room in V.Rooms){<button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("joinRoom",room.Id))'>@room.Title · @room.Id · @room.Phase</button>}</section>}
</main>}
@if(Tab=="Arena lab"){
<main><h1>Build a yard worth fighting over</h1><p>Change terrain, docks and cargo sources in the portable arena format. Validation checks dimensions, distinct floor locations and a walkable route from every dock to every source. It does not prove a fair or balanced match.</p><div class="lab-layout"><section><label>Start from<select @bind="LabArenaId">@foreach(var a in V.Arenas){<option value="@a.Id">@a.Title</option>}</select></label><button disabled="@Busy" @onclick='LoadArena'>Load editable copy</button>@if(Draft is not null){<label>Your arena ID<input maxlength="80" @bind="Draft.Id" /></label><label>Title<input maxlength="100" @bind="Draft.Title" /></label><label>Dispatch description<textarea rows="3" maxlength="500" @bind="Draft.Description"></textarea></label><label>Paint tool<select @bind="PaintTool"><option value=".">Plain floor</option><option value="#">Wall</option><option value="x">Pit</option><option value="^">Belt up</option><option value=">">Belt right</option><option value="v">Belt down</option><option value="<">Belt left</option><option value="0">Shock on beat 1</option><option value="1">Shock on beat 2</option><option value="2">Shock on beat 3</option><option value="dock0">Dock 1</option><option value="dock1">Dock 2</option><option value="dock2">Dock 3</option><option value="dock3">Dock 4</option><option value="source">Toggle cargo source</option></select></label><div class="board painter" style="grid-template-columns:repeat(@Draft.Tiles[0].Length,1fr)">@for(var y=0;y<Draft.Tiles.Count;y++){@for(var x=0;x<Draft.Tiles[y].Length;x++){var px=x;var py=y;var terrain=Draft.Tiles[y][x];var dock=Draft.Docks.FindIndex(p=>p.X==px&&p.Y==py);var source=Draft.Sources.Any(p=>p.X==px&&p.Y==py);<button class="tile @TileClass(terrain)" title="Column @px, row @py" aria-label="Paint column @px, row @py" @onclick="()=>Paint(px,py)">@TerrainLabel(terrain)@(dock>=0?"D"+(dock+1):source?"◆":"")</button>}}</div><p class="small">Click a cell to paint. Docks and loading sources need separate plain floor cells.</p><button class="primary" disabled="@Busy" @onclick="SaveDraft">Validate and save this yard</button>}
<details><summary>Raw portable arena JSON</summary><label>Arena JSON<textarea class="code" rows="24" spellcheck="false" @bind="ArenaText"></textarea></label><button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("saveArena",ArenaText))'>Validate raw JSON</button></details><label>Import .freight.json<input type="file" id="arena-import" accept="application/json,.json" /></label><button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("importArena","arena-import"))'>Import and validate</button></section><section><h2>Terrain language</h2><dl><dt>.</dt><dd>Plain floor</dd><dt>#</dt><dd>Wall: blocks steps and shoves</dd><dt>x</dt><dd>Pit: recover at home and spill cargo</dd><dt>^ &gt; v &lt;</dt><dd>Courier belt, applied after movement</dd><dt>0 1 2</dt><dd>Shock tile, active on that zero-based beat of every round</dd></dl><p>Coordinates start at x=0, y=0 in the top left. Exactly four distinct docks and 1–6 sources must use plain floor. New arenas need a unique ID.</p><h2>Replay theatre</h2><p>Open a portable replay from a friend. It plays recorded beats without treating file contents as verified scores.</p><label>Replay JSON<input type="file" id="replay-import" accept="application/json,.json" /></label><button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("importReplay","replay-import"))'>Open replay</button><h2>Private cloud locker</h2><p>Your current capacity: @V.Revenue.Locker.Used / @V.Revenue.Locker.Limit saved yards. Local play and file exchange remain free. Existing yards stay readable and removable after a subscription ends.</p>@if(V.User is null){<button @onclick='()=>Tab="Friends"'>Create or recover a free courier</button>}else{<button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("refreshLocker"),false)'>Refresh cloud locker</button>@foreach(var cloud in V.CloudArenas){<article><b>@cloud.Title</b><button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("loadCloud",cloud.Id),false)'>Load into this browser</button><button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("deleteCloud",cloud.Id),false)'>Remove cloud copy</button></article>}}@if(V.Revenue.Billing.Error is not null){<p class="error">@V.Revenue.Billing.Error</p>}@if(V.Revenue.Billing.Available){<p>Yard Locker Plus provides 40 private cloud yard slots. Full current pricing and billing terms appear on the hosted Polar checkout. Canceling renewal retains capacity through the paid period.</p><button disabled="@(Busy||V.User is null||V.Revenue.Locker.Premium)" @onclick='()=>Billing("checkout")'>View @(V.Revenue.Billing.Mode=="sandbox"?"sandbox test ":"")checkout on Polar</button><button disabled="@(Busy||V.User is null)" @onclick='()=>Billing("portal")'>Manage Polar billing</button>}else{<p>Paid checkout is unavailable. The owner has not configured a payment account. The free locker provides three private yard slots.</p>}<h2>Your yards</h2><p>Field tests are local. A dispatch bot is an automated rival, never a claimed online player.</p>@foreach(var a in V.Arenas){<article><h3>@a.Title</h3><p>@a.Description</p><button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("sandbox",a.Id))'>Solo field test</button><button disabled="@Busy" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("startPractice",a.Id))'>Local rival match</button><button disabled="@Busy" @onclick='()=>Download("arena",a.Id)'>Export arena</button>@if(!V.BuiltInIds.Contains(a.Id)){<button disabled="@(Busy||V.User is null)" @onclick='()=>Action(()=>Module!.InvokeAsync<View>("saveCloud",a.Id),false)'>Save private cloud copy</button>}</article>}</section></div></main>}
@if(Tab=="Rules"){
<main class="rules"><h1>Read the yard, outguess the courier</h1><h2>A round has three beats</h2><p>Choose exactly three commands, at most four energy. Step costs one, shove two, brace one, wait zero. A shove pushes an adjacent courier chain one tile and makes them spill carried cargo. Brace blocks a shove and a belt for that beat.</p><h2>Every beat has the same order</h2><ol><li>Braces take effect. Shoves resolve in rotating initiative order.</li><li>Steps resolve simultaneously. Contested destinations, swaps and closed cycles stay put; following a courier who vacates a tile is allowed.</li><li>Pick up cargo automatically; deliver on your own dock.</li><li>Belts move unbraced couriers one tile. Floor cargo does not ride belts.</li><li>Pits, leaving the board and active shock tiles cause recovery at the nearest available plain floor from home. Carried cargo is spilled.</li><li>Collect and deliver again; empty loading sources replenish up to three active crates.</li></ol><p>A courier shoved onto a hazard can still step away before the hazard phase. Initiative rotates every beat; the replay records its exact order.</p><h2>Winning and fair information</h2><p>Solo contracts specify a cargo target, recovery allowance and round limit. Private matches last six rounds; most deliveries wins, with shared victories for ties. No one is eliminated. A private committed plan cannot change and is never returned to another player before resolution. All committed commands are revealed in the replay afterward.</p><h2>A missing player</h2><p>The server resolves once all players commit, or when someone refreshes after the 90-second deadline. Missing submissions are three waits, explicitly marked in the replay. Reopening the room with the same courier restores the current state and your locked plan.</p><h2>Portable, local and online</h2><p>Solo saves, custom arenas and records stay in this browser. Arena exports include the design. Replay exports include revealed commands and public match state, never identity recovery keys. Local files can be edited and are not proof of a server-verified score.</p><h2>Support the yard</h2><p>The full current game is free. Optional Yard Locker Plus raises private cloud yard capacity from three to forty when real Polar checkout is configured; its current availability appears in the arena lab. Advertising loads only after a real publisher is configured and you opt in; active private rooms do not load third-party advertising.</p></main>}
@if(V.Revenue.Ads.Available&&V.State is null&&V.Room is null){<section><h2>Optional advertising</h2><p>Choose whether to load Google AdSense on this public dispatch screen. The game works without it.</p><button @onclick="EnableAds">Enable optional advertising</button><div id="optional-ad" aria-label="Advertisement"></div></section>}<footer><span>Original fictional freight yards · English game content</span><a href="https://github.com/muhammetozeski/ThreeBeatFreight">Source &amp; rules</a><a href="/privacy.html">Privacy &amp; storage</a></footer>
}
</div>
@code{
 private Arena? Draft;private string PaintTool=".";private IJSObjectReference? Module; private View? V; private string Tab="Play",Error="",Message="",NewAlias="",Recovery="",JoinCode="",ArenaId="cross-dock",LabArenaId="cross-dock",ArenaText="";private bool Busy,Prediction;private Replay? Preview;private int FrameIndex=-1;private List<Command> Plan=NewPlan();private CancellationTokenSource Stop=new();private DateTimeOffset SnapshotAt;private int LastRound=-1;private string LastRoom="";
 static List<Command> NewPlan()=>[new(),new(),new()];
 string OwnId=>V?.Room is null?"solo":V.User?.Id??"";bool Committed=>V?.Room?.CommittedIds.Contains(OwnId)==true;int Energy=>Plan.Sum(c=>c.Cost);Replay? ShownReplay=>Prediction?Preview:V?.Replay;List<Courier> ShownPlayers=>FrameIndex>=0&&ShownReplay is not null?ShownReplay.Frames[FrameIndex].Players:V?.State?.Players??[];List<Cargo> ShownCrates=>FrameIndex>=0&&ShownReplay is not null?ShownReplay.Frames[FrameIndex].Crates:V?.State?.Crates??[];
 string InviteUrl=>(V?.Origin??"")+"/?room="+V?.Room?.Id;
 string ActualInvite="";
 string DeadlineText=>V?.Room?.Deadline is long deadline?Math.Max(0,(deadline-V.Room.ServerNow)/1000-(int)(DateTimeOffset.UtcNow-SnapshotAt).TotalSeconds)+" seconds remaining (approximate).":"";
 string ResultText=>V?.State?.Result is not Result r?"":r.Winners.Count==0?"Contract missed — dispatch again":r.Winners.Count>1?"Shared victory: "+string.Join(", ",r.Winners.Select(Alias)):Alias(r.Winners[0])+" delivered the win";
 protected override async Task OnAfterRenderAsync(bool first){if(!first)return;try{Module=await JS.InvokeAsync<IJSObjectReference>("import","./assets/freight.mjs");V=await Module.InvokeAsync<View>("init");await LoadArena();JoinCode=V.Invite;Sync(true);_ = Poll();}catch(Exception ex){Report(ex);}StateHasChanged();}
 async Task Poll(){try{while(!Stop.IsCancellationRequested){await Task.Delay(3000,Stop.Token);if(Module is null||Busy||V?.Room is null)continue;await InvokeAsync(async()=>{await Action(()=>Module.InvokeAsync<View>("refresh"),false);});}}catch(OperationCanceledException){}}
 async Task Action(Func<ValueTask<View>> call,bool reset=true){if(Busy)return;Busy=true;Error="";Message="";try{V=await call();Sync(reset);}catch(Exception ex){Report(ex);}finally{Busy=false;StateHasChanged();}}
 void Sync(bool reset){SnapshotAt=DateTimeOffset.UtcNow;var changed=LastRoom!=(V?.Room?.Id??"")||LastRound!=(V?.State?.Round??-1);if(reset||changed){Prediction=false;Preview=null;FrameIndex=-1;}if(V?.Room?.OwnPlan is not null)Plan=V.Room.OwnPlan;else if(reset||changed)Plan=NewPlan();if(reset&&V?.Room?.Phase=="lobby")Tab="Friends";if(reset&&V?.State is not null&&(V.Room is null||V.Room.Phase!="lobby"))Tab="Play";LastRoom=V?.Room?.Id??"";LastRound=V?.State?.Round??-1;}
 void Report(Exception ex){Error=ex.Message.Split('\n')[0];Log.LogWarning("Game action rejected: {ExceptionType}",ex.GetType().Name);}
 async Task Commit(){await Action(()=>Module!.InvokeAsync<View>("commit",Plan));}
 async Task Predict(){if(Busy)return;try{Preview=await Module!.InvokeAsync<Replay>("predict",Plan);Prediction=true;FrameIndex=0;}catch(Exception ex){Report(ex);}}
 void SelectReplay(Replay replay){if(V is not null)V.Replay=replay;Prediction=false;FrameIndex=0;}
 void SetKind(int slot,string value){Plan[slot].Kind=value;Plan[slot].Direction=value is "move" or "shove"?"right":null;Prediction=false;FrameIndex=-1;}
 async Task ReplayMatch(){if(V?.Room is not null)await Action(()=>Module!.InvokeAsync<View>("createRoom",V.State!.Board.Id));else if(V?.Practice==true)await Action(()=>Module!.InvokeAsync<View>("startPractice",V.State!.Board.Id));else if(!string.IsNullOrEmpty(V?.ContractId))await Action(()=>Module!.InvokeAsync<View>("startSolo",V.ContractId));else await Action(()=>Module!.InvokeAsync<View>("sandbox",V!.State!.Board.Id));}
 async Task LoadArena(){try{ArenaText=await Module!.InvokeAsync<string>("arenaJson",LabArenaId);var arena=JsonSerializer.Deserialize<Arena>(ArenaText,new JsonSerializerOptions{PropertyNameCaseInsensitive=true})!;arena.Id="my-"+arena.Id;Draft=arena;ArenaText=JsonSerializer.Serialize(arena,new JsonSerializerOptions{PropertyNamingPolicy=JsonNamingPolicy.CamelCase,WriteIndented=true});}catch(Exception ex){Report(ex);}}
 void Paint(int x,int y){if(Draft is null||Busy)return;if(PaintTool.StartsWith("dock")){var seat=int.Parse(PaintTool[^1..],System.Globalization.CultureInfo.InvariantCulture);Draft.Docks[seat]=new Point{X=x,Y=y};}else if(PaintTool=="source"){var index=Draft.Sources.FindIndex(p=>p.X==x&&p.Y==y);if(index>=0)Draft.Sources.RemoveAt(index);else Draft.Sources.Add(new Point{X=x,Y=y});}else{var row=Draft.Tiles[y].ToCharArray();row[x]=PaintTool[0];Draft.Tiles[y]=new string(row);}ArenaText=JsonSerializer.Serialize(Draft,new JsonSerializerOptions{PropertyNamingPolicy=JsonNamingPolicy.CamelCase,WriteIndented=true});}
 async Task SaveDraft(){if(Draft is null)return;ArenaText=JsonSerializer.Serialize(Draft,new JsonSerializerOptions{PropertyNamingPolicy=JsonNamingPolicy.CamelCase,WriteIndented=true});await Action(()=>Module!.InvokeAsync<View>("saveArena",ArenaText));if(string.IsNullOrEmpty(Error))Message="Arena validated and saved in this browser. Field-test it or export it below.";}
 async Task Download(string kind,string? id=null){try{await Module!.InvokeVoidAsync("exportFile",kind,id);Message="The file was sent to your browser downloads.";}catch(Exception ex){Report(ex);}}
 async Task Billing(string kind){if(Busy)return;Busy=true;try{await Module!.InvokeVoidAsync("openBilling",kind);}catch(Exception ex){Report(ex);}finally{Busy=false;}}
 async Task EnableAds(){try{await Module!.InvokeVoidAsync("enableAds");}catch(Exception ex){Report(ex);}}
 async Task CopyInvite(){try{ActualInvite=await Module!.InvokeAsync<string>("copyInvite");Message="Invitation copied: "+ActualInvite;}catch(Exception ex){Report(ex);}}
 string Alias(string id)=>V?.State?.Players.FirstOrDefault(p=>p.Id==id)?.Alias??V?.Room?.Members.FirstOrDefault(p=>p.Id==id)?.Alias??id;
 static string Color(int seat)=>new[]{"#d0fa26","#ff4e8a","#28cffa","#ffae21"}[Math.Clamp(seat,0,3)];
 static string TileClass(char tile)=>tile=='#'?"wall":tile=='x'?"pit":char.IsDigit(tile)?"shock":"floor";
 static string TerrainLabel(char tile)=>tile switch{'^'=>"↑",'v'=>"↓",'<'=>"←",'>'=>"→",'x'=>"×",'#'=>"",'.'=>"",_=>tile.ToString()};
 string CellLabel(int x,int y,char tile,Courier? player,Cargo? crate,int dock)=>$"Column {x}, row {y}. Terrain {tile}. "+(dock>=0?$"Dock {dock+1}. ":"")+(player is not null?$"{player.Alias}, {(player.Cargo is null?"empty hands":"carrying cargo")}. ":"")+(crate is not null?"Cargo present.":"");
 string EventText(JsonElement evt){var type=evt.GetProperty("type").GetString()??"event";var who=evt.TryGetProperty("playerId",out var p)?Alias(p.GetString()??""):"Yard";return who+": "+type.Replace('-',' ')+(evt.TryGetProperty("reason",out var reason)?" — "+reason.GetString():"");}
 public async ValueTask DisposeAsync(){Stop.Cancel();Stop.Dispose();if(Module is not null)await Module.DisposeAsync();}
}







